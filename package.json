{
  "name": "codeweald",
  "version": "0.1.0",
  "description": "An RPG-based introduction to Python for middle school",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare:assets": "tsx scripts/copy-pyodide.ts && tsx scripts/make-art.ts && tsx scripts/build-content.ts",
    "dev": "npm run prepare:assets && vite",
    "build": "npm run prepare:assets && tsc --noEmit && vite build && tsx scripts/size-budget.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content": "tsx scripts/build-content.ts",
    "validate-content": "tsx scripts/validate-content.ts",
    "new-quest": "tsx scripts/new-quest.ts",
    "schema": "tsx scripts/write-schema.ts",
    "reading-level": "tsx scripts/reading-level.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "solutions": "tsx scripts/solutions.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/opendyslexic": "5.3.0",
    "@preact/signals": "2.11.3",
    "idb-keyval": "6.3.0",
    "phaser": "4.2.1",
    "preact": "10.29.8",
    "pyodide": "314.0.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
