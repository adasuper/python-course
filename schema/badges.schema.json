{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "name": {
        "type": "string",
        "maxLength": 40
      },
      "emoji": {
        "type": "string",
        "maxLength": 8
      },
      "description": {
        "type": "string"
      },
      "trigger": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "quest_type_completed"
              },
              "type": {
                "type": "string",
                "enum": [
                  "predict",
                  "investigate",
                  "fix",
                  "fill",
                  "parsons",
                  "modify",
                  "make",
                  "boss"
                ]
              }
            },
            "required": [
              "kind",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "completed_without_hints"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "distinct_attempts"
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "kind",
              "count"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "passed_after_failures"
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "kind",
              "count"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "counter"
              },
              "counter": {
                "type": "string",
                "enum": [
                  "realErrorViews",
                  "workshopRuns",
                  "duckChats"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "kind",
              "counter",
              "count"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "boss_defeated"
              },
              "region": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              }
            },
            "required": [
              "kind",
              "region"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "pois_visited"
              },
              "region": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              }
            },
            "required": [
              "kind",
              "region"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "side_quests"
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "kind",
              "count"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "checks_completed"
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "kind",
              "count"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "quest_completed"
              },
              "quest": {
                "type": "string",
                "pattern": "^r\\d+-(q\\d+|boss|side\\d+)-[a-z0-9-]+$"
              }
            },
            "required": [
              "kind",
              "quest"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "required": [
      "id",
      "name",
      "emoji",
      "description",
      "trigger"
    ],
    "additionalProperties": false
  }
}
