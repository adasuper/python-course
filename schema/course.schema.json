{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string"
    },
    "opening": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "speaker": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "speaker",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "regions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "enabled": {
            "default": true,
            "type": "boolean"
          },
          "lessons": {
            "default": 2,
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    "side_quests": {
      "default": true,
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "title",
    "opening",
    "regions"
  ],
  "additionalProperties": false
}
