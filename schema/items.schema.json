{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "name": {
        "type": "string"
      },
      "icon": {
        "type": "string"
      },
      "region": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "description": {
        "type": "string"
      },
      "example": {
        "type": "string"
      }
    },
    "required": [
      "id",
      "name",
      "icon",
      "region",
      "description"
    ],
    "additionalProperties": false
  }
}
